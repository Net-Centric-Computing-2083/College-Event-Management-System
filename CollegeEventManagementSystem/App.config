<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <connectionStrings>
    <!--
    ============================================================================
    CHANGE THE SQL SERVER INSTANCE NAME HERE IF REQUIRED.

    This is the ONLY place in the whole project where the connection
    string is written. DatabaseHelper.cs reads it from this file.

    Common values for "Data Source":

        .\SQLEXPRESS        -> SQL Server Express on this computer (default)
        (local)             -> default local instance
        localhost           -> default local instance
        DESKTOP-ABC123      -> named computer / named instance

    If SQL Server uses a username and password instead of Windows login, use:

        Data Source=.\SQLEXPRESS;Initial Catalog=CollegeEventDB;User ID=sa;Password=yourpassword;
    ============================================================================
    -->
    <add name="CollegeEventDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=CollegeEventDB;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
